{
  "name": "standbycue-presentation-timer",
  "version": "1.0.8",
  "description": "StandbyCue Presentation timer — an always-on-top, movable, resizable window to sit next to PowerPoint Presenter View.",
  "author": "Holi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "no.holi.standbycuetimer",
    "productName": "StandbyCue Presentation timer",
    "artifactName": "StandbyCue-Presentation-Timer.${ext}",
    "afterPack": "build/afterPack.js",
    "files": ["main.js", "preload.js", "renderer/**/*", "assets/**/*"],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}
